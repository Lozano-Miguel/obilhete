# Public base URL of the app (used for OG image / metadata URLs)
NEXT_PUBLIC_BASE_URL=

# Postgres connection string (required by lib/db.ts)
DATABASE_URL=

# TMDB API read access token (v4 bearer token)
TMDB_API_KEY=

# Groq API key (recommendations + personality tag)
GROQ_API_KEY=

# URL of the private Python scraper service (default http://localhost:8001)
SCRAPER_SERVICE_URL=
